# Shared exclusions for application and ingest builds.
# Dockerfile-specific exclusions live beside the relevant Dockerfile.

# JavaScript dependencies
node_modules/
frontend/node_modules/

# Python caches and virtual environments
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Version control and temporary working files
.git/
.tmp/
logs/

# Local secrets and environment overrides
.env
.env.*
.envrc

# Not required in runtime images
*.ipynb
.ipynb_checkpoints/
data/

# Local database exports and generated backend artifacts
*.db
backend/database/*.csv
backend/database/*.json
backend/database/*.npz
backend/database/images/*.jpg
backend/database/images/*.png

# Frontend build outputs (the application Dockerfile builds its own frontend)
frontend/dist/
frontend/.vite/
frontend/build/

# Local editor settings
.vscode/
